    {
      "id": "5.25.8",
      "label": "5.25.8",
      "numbers": [
        8
      ],
      "devanagari": "सा वेपमाना पतिता प्रवाते कदळी यथा |\nराक्षसीनां भयत्रस्ता विवर्णवदनाभवत्",
