          "devanagari": "वैदेही धरिष्यति यदि",
          "meaning": "if Seetha can survive",
          "anvayaIndex": 1,
          "verseIndex": 2
        },
        {
          "itrans": "maasam",
          "iast": "māsam",
          "devanagari": "मासं",
          "meaning": "for a month",
          "anvayaIndex": 2,
          "verseIndex": 4
        },
        {
          "itrans": "chiram jiivati",
          "iast": "ciram jīvati",
          "devanagari": "चिरं जीवति",
          "meaning": "it means she is surviving for long!",
          "anvayaIndex": 3,
          "verseIndex": 0
        },
