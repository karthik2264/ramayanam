      "glosses": [
        {
          "itrans": "saH",
          "iast": "saḥ",
          "devanagari": "सः",
          "meaning": "that Hanuma",
          "anvayaIndex": 0,
          "verseIndex": 3
        },
        {
          "itrans": "vanaraviirasattamaH",
          "iast": "vanaravīrasattamaḥ",
          "devanagari": "वनरवीरसत्तमः",
          "meaning": "the best among Vanara warriors",
          "anvayaIndex": 1,
          "verseIndex": null
