      "notes": [],
      "glosses": [
        {
          "itrans": "raaamaH saha saumitri",
          "iast": "rāamaḥ saha saumitri",
          "devanagari": "राअमः सह सौमित्रि",
          "meaning": "Rama, with, Soumitri",
          "anvayaIndex": 0,
          "verseIndex": 0
