    {
      "id": "3.8.11",
      "label": "3.8.11",
      "numbers": [
        11
      ],
      "devanagari": "अरिष्टम् गच्छ पन्थानम् राम सौमित्रिणा सह |\nसीतया च अनया सार्धम् छाय एव अनुवृत्तया",
      "iast": "ariṣṭam gaccha panthānam rāma saumitriṇā saha |\nsītayā ca anayā sārdham chāya eva anuvṛttayā",
      "translation": "\"Proceed in an invulnerable way, Rama, along with Lakshmana, and with this Seetha while she follows you closely like a shadow...",
      "notes": [],
      "glosses": [
        {
          "itrans": "raama saumitriNaa saha",
          "iast": "rāma saumitriṇā saha",
          "devanagari": "राम सौमित्रिणा सह",
          "meaning": "Rama, Soumitri, along with",
          "anvayaIndex": 0,
          "verseIndex": 3
        },
        {
          "itrans": "Chaayayaa iva anu vR^ittayaa anayaa siitayaa saa ardham ca",
          "iast": "chāyayā iva anu vṛttayā anayā sītayā sā ardham ca",
          "devanagari": "छायया इव अनु वृत्तया अनया सीतया सा अर्धं च",
          "meaning": "shadow like, closely, following you, with this Seetha",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
          "itrans": "ariSTam panthaanam gacCha",
          "iast": "ariṣṭam panthānam gaccha",
          "devanagari": "अरिष्टं पन्थानं गच्छ",
          "meaning": "invulnerable, on way, you may go.",
          "anvayaIndex": 2,
          "verseIndex": 0
        }
      ]
    },
    {
      "id": "3.8.12",
      "label": "3.8.12",
      "numbers": [
        12
      ],
      "devanagari": "पश्य आश्रम पदम् रंयम् दण्डकारण्य वासिनाम् |\nएषाम् तपस्विनाम् वीर तपसा भावित आत्मनाम्",
      "iast": "paśya āśrama padam raṃyam daṇḍakāraṇya vāsinām |\neṣām tapasvinām vīra tapasā bhāvita ātmanām",
