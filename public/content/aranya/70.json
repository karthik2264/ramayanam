          "verseIndex": 1
        },
        {
          "itrans": "asya bhaaryaa rakSasaa apahR^itaa",
          "iast": "asya bhāryā rakṣasā apahṛtā",
          "devanagari": "अस्य भार्या रक्षसा अपहृता",
          "meaning": "his, wife, by demon, abducted",
          "anvayaIndex": 3,
          "verseIndex": null
        },
        {
          "itrans": "yaam icChantau iha aagatau",
          "iast": "yām icchantau iha āgatau",
          "devanagari": "यां इच्छन्तौ इह आगतौ",
          "meaning": "whom, wishing [to retrieve,] to here, [we] came.",
          "anvayaIndex": 4,
          "verseIndex": 9
        }
      ]
    },
    {
      "id": "3.70.16",
      "label": "3.70.16",
      "numbers": [
        16
      ],
      "devanagari": "त्वम् तु को वा किम् अर्थम् वा कबन्ध सदृशो वने |\nआस्येन उरसि दीप्तेन भग्न जन्घो विचेष्टसे",
      "iast": "tvam tu ko vā kim artham vā kabandha sadṛśo vane |\nāsyena urasi dīptena bhagna jangho viceṣṭase",
      "translation": "\"But who are you? Your legs are broken, and your mouth is infernal, yet it is on your chest, and alike a topless, rootless tree trunk you are sprawling in the forest, how so, or, for what reason?\" Lakshmana asked the demon thus.",
      "notes": [],
      "glosses": [
        {
          "itrans": "tvam tu",
          "iast": "tvam tu",
          "devanagari": "त्वं तु",
          "meaning": "you, but",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "kaH vaa",
          "iast": "kaḥ vā",
          "devanagari": "कः वा",
          "meaning": "who, or",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
          "itrans": "kabandha sadR^ishaH",
          "iast": "kabandha sadṛśaḥ",
          "devanagari": "कबन्ध सदृशः",
          "meaning": "trunk, alike",
          "anvayaIndex": 2,
          "verseIndex": 7
        },
        {
          "itrans": "urasi diiptena aasyena",
          "iast": "urasi dīptena āsyena",
          "devanagari": "उरसि दीप्तेन आस्येन",
          "meaning": "in chest, infernal, with mouth",
          "anvayaIndex": 3,
          "verseIndex": 10
        },
        {
          "itrans": "bhagna janghaH",
