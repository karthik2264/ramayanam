          "meaning": "alive, somehow",
          "anvayaIndex": 3,
          "verseIndex": 0
        },
        {
          "itrans": "me pravraajanam",
          "iast": "me pravrājanam",
          "devanagari": "मे प्रव्राजनं",
          "meaning": "my, peregrination",
          "anvayaIndex": 4,
          "verseIndex": 7
        },
        {
