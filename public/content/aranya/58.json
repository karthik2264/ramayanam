          "verseIndex": 6
        },
        {
          "itrans": "ucCaiH vadataa",
          "iast": "ucCaiḥ vadatā",
          "devanagari": "उच्Cऐः वदता",
          "meaning": "loudly, who shouted",
          "anvayaIndex": 3,
          "verseIndex": 5
        },
        {
          "itrans": "tena rakSasaa",
          "iast": "tena rakṣasā",
          "devanagari": "तेन रक्षसा",
          "meaning": "by him, demon - Maareecha",
          "anvayaIndex": 4,
