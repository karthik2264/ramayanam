          "meaning": "dubiously, imposed, valour [vainglorious]",
          "anvayaIndex": 7,
          "verseIndex": 20
        },
        {
          "itrans": "aham buddhyaa anupashyaami",
          "iast": "aham buddhyā anupaśyāmi",
