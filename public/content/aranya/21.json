          "anvayaIndex": 5,
          "verseIndex": 4
        },
        {
          "itrans": "vinirdiSTaaH",
          "iast": "vinirdiṣṭāḥ",
          "devanagari": "विनिर्दिष्टाः",
          "meaning": "very, clearly, directed] commanded",
          "anvayaIndex": 6,
          "verseIndex": 10
        },
        {
          "itrans": "punaH kim artham rudyate",
          "iast": "punaḥ kim artham rudyate",
          "devanagari": "पुनः किं अर्थं रुद्यते",
          "meaning": "again, what, for, it is wept - you howl.",
          "anvayaIndex": 7,
          "verseIndex": 11
        }
      ]
    },
    {
      "id": "3.21.3",
      "label": "3.21.3",
      "numbers": [
        3
      ],
      "devanagari": "भक्ताः चैव अनुरक्ताः च हिताः च मम नित्यशः |\nहन्यमाना अपि न हन्यन्ते न न कुर्युः वचो मम",
      "iast": "bhak{}tāḥ caiva anurak{}tāḥ ca hitāḥ ca mama nityaśaḥ |\nhanyamānā api na hanyante na na kuryuḥ vaco mama",
      "translation": "\"Those demons are my admirers, adherers and they always remained my well-wishers, hence there is no question of their non-accomplishment of my orders.",
      "notes": [],
      "glosses": [
        {
          "itrans": "bhaktaaH caiva anuraktaaH ca",
          "iast": "bhaktāḥ caiva anuraktāḥ ca",
          "devanagari": "भक्ताः चैव अनुरक्ताः च",
          "meaning": "admirers, also, adherers, also",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "nityashaH mama hitaaH ca",
          "iast": "nityaśaḥ mama hitāḥ ca",
          "devanagari": "नित्यशः मम हिताः च",
          "meaning": "always, of mine, well-wishers",
          "anvayaIndex": 1,
          "verseIndex": 4
        },
        {
          "itrans": "hanyamaanaa api na hanyante",
          "iast": "hanyamānā api na hanyante",
          "devanagari": "हन्यमाना अपि न हन्यन्ते",
          "meaning": "being killed, even, not, killable",
          "anvayaIndex": 2,
          "verseIndex": 8
        },
        {
          "itrans": "mama vacaH",
          "iast": "mama vacaḥ",
          "devanagari": "मम वचः",
          "meaning": "my, word [order]",
          "anvayaIndex": 3,
          "verseIndex": 15
        },
        {
          "itrans": "na na kuryuH",
          "iast": "na na kuryuḥ",
          "devanagari": "न न कुर्युः",
          "meaning": "no, not, doers - no question of not accomplishing my order.",
          "anvayaIndex": 4,
          "verseIndex": 12
        }
      ]
    },
    {
      "id": "3.21.4",
      "label": "3.21.4",
      "numbers": [
        4
      ],
      "devanagari": "किम् एतत् श्रोतुम् इच्छ्हामि कारणम् यत् कृते पुनः |\nहा नाथ इति विनर्दन्ती सर्पवत् चेष्टसे क्षितौ",
      "iast": "kim etat śrotum icchhāmi kāraṇam yat kṛte punaḥ |\nhā nātha iti vinardantī sarpavat ceṣṭase kṣitau",
      "translation": "\"Owing to what you are highly bawling by saying, 'haa, lord' and wriggle on the ground like a snake? I would like to know the reason for all this, what is it?",
      "notes": [],
      "glosses": [
        {
          "itrans": "yat kR^ite",
          "iast": "yat kṛte",
          "devanagari": "यत् कृते",
          "meaning": "what, owing to",
          "anvayaIndex": 0,
          "verseIndex": 5
        },
        {
          "itrans": "haa naatha iti",
          "iast": "hā nātha iti",
          "devanagari": "हा नाथ इति",
          "meaning": "ha, lord, thus",
          "anvayaIndex": 1,
          "verseIndex": 8
        },
        {
          "itrans": "vi nardantii",
          "iast": "vi nardantī",
          "devanagari": "वि नर्दन्ती",
          "meaning": "verily, bawling",
          "anvayaIndex": 2,
          "verseIndex": 11
        },
        {
          "itrans": "punaH sarpa vat",
          "iast": "punaḥ sarpa vat",
          "devanagari": "पुनः सर्प वत्",
          "meaning": "again, serpent, as with",
          "anvayaIndex": 3,
          "verseIndex": null
        },
        {
          "itrans": "kSitau ceSTase",
          "iast": "kṣitau ceṣṭase",
          "devanagari": "क्षितौ चेष्टसे",
          "meaning": "on ground, gesturing - wriggling",
          "anvayaIndex": 4,
          "verseIndex": 13
        },
        {
          "itrans": "etat kaaraNam",
          "iast": "etat kāraṇam",
          "devanagari": "एतत् कारणं",
          "meaning": "for this, reason",
          "anvayaIndex": 5,
          "verseIndex": 1
        },
        {
          "itrans": "kim",
          "iast": "kim",
          "devanagari": "किं",
          "meaning": "what is it",
          "anvayaIndex": 6,
          "verseIndex": 0
        },
        {
          "itrans": "shrotum icChaami",
          "iast": "śrotum icchāmi",
          "devanagari": "श्रोतुं इच्छामि",
          "meaning": "to listen, I wish to.",
          "anvayaIndex": 7,
          "verseIndex": 2
        }
      ]
    },
    {
      "id": "3.21.5",
      "label": "3.21.5",
      "numbers": [
        5
      ],
      "devanagari": "अनाथ वत् विलपसि किम् नु नाथे मयि स्थिते |\nउत्तिष्ठोत्तिष्ठ मा मैवम् वैक्लव्यम् त्यज्यताम् इति",
      "iast": "anātha vat vilapasi kim nu nāthe mayi sthite |\nuttiṣṭhottiṣṭha mā maivam vaiklavyam tyajyatām iti",
      "translation": "\"I am here to take care of you, then why should you really cry out like an uncared-for being, get up...get up, and ward off this sort of perplexity.\" Thus Khara said to Shuurpanakha.",
      "notes": [],
      "glosses": [
        {
          "itrans": "naathe mayi sthite",
          "iast": "nāthe mayi sthite",
          "devanagari": "नाथे मयि स्थिते",
          "meaning": "one who cares for, I am, when I am available",
          "anvayaIndex": 0,
          "verseIndex": 5
        },
        {
          "itrans": "maam",
          "iast": "mām",
          "devanagari": "मां",
          "meaning": "to me",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
          "itrans": "kim nu",
          "iast": "kim nu",
          "devanagari": "किं नु",
          "meaning": "why, really",
          "anvayaIndex": 2,
          "verseIndex": 3
        },
        {
          "itrans": "a naatha vat vilapasi",
          "iast": "a nātha vat vilapasi",
          "devanagari": "अ नाथ वत् विलपसि",
          "meaning": "un, cared-for, like, you cry out",
          "anvayaIndex": 3,
          "verseIndex": 0
        },
        {
          "itrans": "uttiSTha uttiSTha",
          "iast": "uttiṣṭha uttiṣṭha",
          "devanagari": "उत्तिष्ठ उत्तिष्ठ",
          "meaning": "get up, get up",
          "anvayaIndex": 4,
          "verseIndex": null
        },
        {
          "itrans": "evam vaiklavyam tyajyataam",
          "iast": "evam vaiklavyam tyajyatām",
          "devanagari": "एवं वैक्लव्यं त्यज्यतां",
          "meaning": "this sort, perplexity, ward off, thus",
          "anvayaIndex": 5,
          "verseIndex": null
        },
        {
          "itrans": "iti",
          "iast": "iti",
          "devanagari": "इति",
          "meaning": "thus he said.",
          "anvayaIndex": 6,
          "verseIndex": 13
        }
      ]
    },
    {
      "id": "3.21.6",
      "label": "3.21.6",
      "numbers": [
        6
      ],
      "devanagari": "इति एवम् उक्ता दुर्धर्षा खरेण परिसान्त्विता |\nविमृज्य नयने स अस्रे खरम् भ्रातरम् अब्रवीत्",
      "iast": "iti evam uk{}tā durdharṣā khareṇa parisāntvitā |\nvimṛjya nayane sa asre kharam bhrātaram abravīt",
      "translation": "She that Shuurpanakha who is otherwise an unassuageable one is wholly pacified when Khara spoke to her thus that way, and she on dabbing her tearful eyes then spoke to her brother Khara.",
      "notes": [],
      "glosses": [
        {
          "itrans": "iti evam uktaa",
          "iast": "iti evam uktā",
          "devanagari": "इति एवं उक्ता",
