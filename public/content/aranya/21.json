          "anvayaIndex": 2,
          "verseIndex": 7
        },
        {
          "itrans": "idaaniim",
          "iast": "idānīm",
          "devanagari": "इदानीं",
          "meaning": "now - just a while back",
          "anvayaIndex": 3,
          "verseIndex": 1
        },
        {
          "itrans": "praaptaa asmi",
          "iast": "prāptā asmi",
          "devanagari": "प्राप्ता अस्मि",
          "meaning": "came here, I am",
          "anvayaIndex": 4,
          "verseIndex": 0
        },
        {
          "itrans": "tvayaa parisaanvitaa ca",
          "iast": "tvayā parisānvitā ca",
          "devanagari": "त्वया परिसान्विता च",
          "meaning": "by you, completely, comforted, also - isn't it.",
          "anvayaIndex": 5,
          "verseIndex": null
        }
      ]
    },
    {
      "id": "3.21.8",
      "label": "3.21.8",
      "numbers": [
        8
      ],
      "devanagari": "प्रेषिताः च त्वया शूरा राक्षसाः ते चतुर् दश |\nनिहन्तुम् राघवम् घोराम् मत् प्रियार्थम् स लक्ष्मणम्",
      "iast": "preṣitāḥ ca tvayā śūrā rākṣasāḥ te catur daśa |\nnihantum rāghavam ghorām mat priyārtham sa lakṣmaṇam",
      "translation": "\"Oh, valiant brother, for my delight you too have sent fourteen demons to eliminate that atrocious Rama along with Lakshmana, isn't it?",
      "notes": [],
      "glosses": [
        {
          "itrans": "shuuraa",
          "iast": "śūrā",
          "devanagari": "शूरा",
          "meaning": "oh, valiant one",
          "anvayaIndex": 0,
          "verseIndex": 3
        },
        {
          "itrans": "tvayaa",
          "iast": "tvayā",
          "devanagari": "त्वया",
          "meaning": "by you",
          "anvayaIndex": 1,
          "verseIndex": 2
        },
        {
          "itrans": "mat priya artham",
          "iast": "mat priya artham",
          "devanagari": "मत् प्रिय अर्थं",
          "meaning": "to my, delight, for the reason of",
          "anvayaIndex": 2,
          "verseIndex": 11
        },
        {
          "itrans": "sa lakSmaNam",
          "iast": "sa lakṣmaṇam",
          "devanagari": "स लक्ष्मणं",
          "meaning": "with, Lakshmana",
          "anvayaIndex": 3,
          "verseIndex": 13
        },
        {
          "itrans": "ghoram raaghavam nihantum",
          "iast": "ghoram rāghavam nihantum",
          "devanagari": "घोरं राघवं निहन्तुं",
          "meaning": "atrocious, Raghava, to eliminate",
