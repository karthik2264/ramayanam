    {
      "id": "3.41.7",
      "label": "3.41.7",
      "numbers": [
        7
      ],
      "devanagari": "अमात्यैः काम वृत्तो हि राजा कापथम् आश्रितः |\nनिग्राह्यः सर्वथा सद्भिः न निग्राह्यो निगृह्यसे",
      "iast": "amātyaiḥ kāma vṛtto hi rājā kāpatham āśritaḥ |\nnigrāhyaḥ sarvathā sadbhiḥ na nigrāhyo nigṛhyase",
      "translation": "\"Veracious ministers have to restrain a self-willed king when he relies on a wrong-route, isn't it. But you are unrestrained by your ministers though you are self-willed and though you are taking a wrong-route.",
      "notes": [],
      "glosses": [
        {
          "itrans": "kaama vR^ittaH",
          "iast": "kāma vṛttaḥ",
          "devanagari": "काम वृत्तः",
          "meaning": "self, willed [or, lewdly, behaving]",
          "anvayaIndex": 0,
          "verseIndex": 1
        },
        {
          "itrans": "kaa patham aashritaH raajaa",
          "iast": "kā patham āśritaḥ rājā",
          "devanagari": "का पथं आश्रितः राजा",
          "meaning": "wrong, route, who relies on, that king",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
          "itrans": "sadbhiH amaatyaiH sarvathaa nigraahyaH hi",
          "iast": "sadbhiḥ amātyaiḥ sarvathā nigrāhyaḥ hi",
          "devanagari": "सद्भिः अमात्यैः सर्वथा निग्राह्यः हि",
          "meaning": "by veracious, by ministers, always, restrainable, isn't it",
          "anvayaIndex": 2,
          "verseIndex": null
        },
        {
          "itrans": "nigraahyaH",
          "iast": "nigrāhyaḥ",
          "devanagari": "निग्राह्यः",
          "meaning": "restrainable [such as you are you are]",
          "anvayaIndex": 3,
          "verseIndex": 7
        },
        {
          "itrans": "na nigR^ihyase",
          "iast": "na nigṛhyase",
          "devanagari": "न निगृह्यसे",
          "meaning": "not, being restrained.",
          "anvayaIndex": 4,
          "verseIndex": 10
        }
      ]
    },
    {
      "id": "3.41.8",
      "label": "3.41.8",
      "numbers": [
        8
      ],
      "devanagari": "धर्मम् अर्थम् च कामम् च यशः च जयताम् वर |\nस्वामि प्रसादात् सचिवाः प्राप्नुवन्ति निशाचर",
      "iast": "dharmam artham ca kāmam ca yaśaḥ ca jayatām vara |\nsvāmi prasādāt sacivāḥ prāpnuvanti niśācara",
      "translation": "\"Oh, best conqueror Ravana, probity, prosperity and pleasures, and even the popularity of the ministers, oh, night-walker, are achieved at the beneficence of their master.",
      "notes": [
        "The popularity, fame etc., of someone is said as <em>yaśas</em>and there is another word taken as a synonym <em>kīrti</em>. For this Rama Tilaka says: <em>yaśaḥ sva deśa khyāti, kīrti deśāntara khyāti</em>. Thus <em>'yaśas</em>is the fame within one's own country and <em>kīrti</em>is cross-country fame. For this, another ancient commentator Kulluka Bhatt says: <em>jīvataḥ khyāti rūpam yaśaḥ, mṛtasya khyāti rūpām kīrtim</em>'a living person's fame is <em>yaśaḥ</em>and a dead person fame is <em>kīrti</em>Because Ravana is alive and Maareecha wishes him to be living, he used that chosen word."
      ],
      "glosses": [
        {
          "itrans": "jayataam vara",
          "iast": "jayatām vara",
          "devanagari": "जयतां वर",
          "meaning": "oh, among conquerors, the best - Ravana",
          "anvayaIndex": 0,
          "verseIndex": 7
        },
        {
          "itrans": "nishaacara",
          "iast": "niśācara",
          "devanagari": "निशाचर",
          "meaning": "oh, night-walker",
          "anvayaIndex": 1,
          "verseIndex": 13
        },
        {
          "itrans": "sacivaaH",
          "iast": "sacivāḥ",
          "devanagari": "सचिवाः",
          "meaning": "ministers",
