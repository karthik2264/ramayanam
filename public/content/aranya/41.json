          "iast": "[mārīcaḥ",
          "devanagari": "[मारीचः",
          "meaning": "Maareecha]",
          "anvayaIndex": 4,
          "verseIndex": null
        },
        {
          "itrans": "raakSasa adhipam",
          "iast": "rākṣasa adhipam",
          "devanagari": "राक्षस अधिपं",
          "meaning": "to demon's, king",
          "anvayaIndex": 5,
          "verseIndex": 10
        },
        {
          "itrans": "paruSam vaakyam",
          "iast": "paruṣam vākyam",
          "devanagari": "परुषं वाक्यं",
