          "meaning": "as a king, also",
          "anvayaIndex": 2,
          "verseIndex": 4
        },
        {
          "itrans": "aaaptaH",
          "iast": "āaptaḥ",
          "devanagari": "आअप्तः",
          "meaning": "who is ordered",
