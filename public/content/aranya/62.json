          "anvayaIndex": 4,
          "verseIndex": 12
        },
        {
          "itrans": "kathamcana",
          "iast": "kathamcana",
          "devanagari": "कथम्चन",
          "meaning": "in anyway",
          "anvayaIndex": 5,
          "verseIndex": 17
        },
        {
