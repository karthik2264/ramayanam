          "iast": "nir vīrya iti",
          "devanagari": "निर् वीर्य इति",
          "meaning": "[a person] without, vigour, thus as",
          "anvayaIndex": 1,
          "verseIndex": 0
        },
        {
          "itrans": "nir dayaH ca",
          "iast": "nir dayaḥ ca",
          "devanagari": "निर् दयः च",
          "meaning": "without, pity, also",
          "anvayaIndex": 2,
          "verseIndex": 5
        },
        {
