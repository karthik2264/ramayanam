          "iast": "mama",
          "devanagari": "मम",
          "meaning": "to me",
          "anvayaIndex": 5,
          "verseIndex": 14
        },
        {
          "itrans": "shuunya eva hi",
          "iast": "śūnya eva hi",
          "devanagari": "शून्य एव हि",
          "meaning": "void, thus, indeed",
          "anvayaIndex": 6,
          "verseIndex": 8
        },
        {
