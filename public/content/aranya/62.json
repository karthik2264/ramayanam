          "iast": "mām vane utsṛjya",
          "devanagari": "मां वने उत्सृज्य",
          "meaning": "me, in forest, forsaking",
          "anvayaIndex": 1,
          "verseIndex": 1
        },
        {
          "itrans": "shubhaam ayodhyaa puriim gacCha",
          "iast": "śubhām ayodhyā purīm gaccha",
          "devanagari": "शुभां अयोध्या पुरीं गच्छ",
          "meaning": "to auspicious, city, to Ayoidhya, [you Lakshmana] you go back",
          "anvayaIndex": 2,
          "verseIndex": 5
        },
        {
          "itrans": "aham tu",
          "iast": "aham tu",
          "devanagari": "अहं तु",
          "meaning": "I, on my part",
          "anvayaIndex": 3,
          "verseIndex": 10
        },
