          "iast": "iti vakśyati",
          "devanagari": "इति वक्श्यति",
          "meaning": "thus, they say [denounce]",
          "anvayaIndex": 3,
          "verseIndex": 8
        },
        {
          "itrans": "siitaa apa nayanena",
          "iast": "sītā apa nayanena",
          "devanagari": "सीता अप नयनेन",
          "meaning": "in Seetha's, away, leading - regarding abduction",
          "anvayaIndex": 4,
          "verseIndex": 13
        },
        {
          "itrans": "me",
          "iast": "me",
          "devanagari": "मे",
          "meaning": "my",
          "anvayaIndex": 5,
          "verseIndex": 15
        },
        {
          "itrans": "kaataratvam",
          "iast": "kātaratvam",
          "devanagari": "कातरत्वं",
          "meaning": "timidity [ineptitude]",
          "anvayaIndex": 6,
          "verseIndex": 10
        },
        {
          "itrans": "prakaasham hi",
          "iast": "prakāśam hi",
          "devanagari": "प्रकाशं हि",
          "meaning": "will be self-evident, indeed.",
          "anvayaIndex": 7,
          "verseIndex": 11
        }
      ]
    },
    {
      "id": "3.62.12",
      "label": "3.62.12",
      "numbers": [
        12
      ],
      "devanagari": "निवृत्त वन वासः च जनकम् मिथिल अधिपम्\nकुशलम् परिपृच्छन्तम् कथम् शक्षे निरीक्षितुम् |",
      "iast": "nivṛtta vana vāsaḥ ca janakam mithila adhipam\nkuśalam paripṛcchantam katham śakśe nirīkśitum |",
      "translation": "\"When the king of Mithila Janaka asks after the wellbeing of all the three of us after the completion of forest living, how do I have the face to stand him?",
      "notes": [],
      "glosses": [
        {
          "itrans": "nivR^itta vana vaasaH ca",
          "iast": "nivṛtta vana vāsaḥ ca",
