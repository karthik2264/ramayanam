          "iast": "sama stham anuranjante",
          "devanagari": "सम स्थं अनुरन्जन्ते",
          "meaning": "[husbands] in good fortune, they devote",
          "anvayaIndex": 3,
          "verseIndex": 7
        },
        {
          "itrans": "viSama stham tyajanti ca",
          "iast": "viṣama stham tyajanti ca",
          "devanagari": "विषम स्थं त्यजन्ति च",
          "meaning": "in ill fortune, leave off.",
          "anvayaIndex": 4,
          "verseIndex": 11
        }
      ]
