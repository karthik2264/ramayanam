          "iast": "khedaiḥ ca na vimānitā",
          "devanagari": "खेदैः च न विमानिता",
          "meaning": "by distresses, also, not, discomforted",
          "anvayaIndex": 1,
          "verseIndex": 4
        },
        {
          "itrans": "eSaa",
          "iast": "eṣā",
          "devanagari": "एषा",
          "meaning": "she is",
          "anvayaIndex": 2,
          "verseIndex": 0
