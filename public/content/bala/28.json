        },
        {
          "itrans": "kaarya kaaleshu",
          "iast": "kārya kāleśu",
          "devanagari": "कार्य कालेशु",
          "meaning": ", in work's, time, [need of the hour]",
          "anvayaIndex": 1,
          "verseIndex": 8
        },
        {
          "itrans": "me saahaayyam kariSyatha",
          "iast": "me sāhāyyam kariṣyatha",
          "devanagari": "मे साहाय्यं करिष्यथ",
          "meaning": "to me, assistance, you render",
          "anvayaIndex": 2,
          "verseIndex": 10
        },
        {
          "itrans": "yathaa iSTam gamyataam",
          "iast": "yathā iṣṭam gamyatām",
          "devanagari": "यथा इष्टं गम्यतां",
          "meaning": "as you, wish, you can go",
          "anvayaIndex": 3,
          "verseIndex": null
        },
        {
          "itrans": "iti raghu nandanaH taan aaha",
          "iast": "iti raghu nandanaḥ tān āha",
          "devanagari": "इति रघु नन्दनः तान् आह",
          "meaning": "thus, Ragu's legatee, to them, said.",
          "anvayaIndex": 4,
          "verseIndex": null
        }
      ]
    },
    {
      "id": "1.28.15",
      "label": "1.28.15",
      "numbers": [
        15
      ],
      "devanagari": "अथ ते राममामन्त्र्य कृत्वा चापि प्रदक्षिणम् |\nएवमस्त्विति काकुत्स्थमुक्त्वा जग्मुर्यथागतम्",
      "iast": "atha te rāmam āman.htrya kṛtvā ca api pradakṣiṇam |\nevam astu iti kākutstham uk{}tvā jagmuḥ yathāāgatam",
      "translation": "Saying \"it will be done that way\" to Rama, the legatee of Kakutstha-s, also on performing circumambulation to him and then on taking his consent those deities have gone away as they have come.",
