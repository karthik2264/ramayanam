          "iast": "a nṛśamśam vā",
          "devanagari": "अ नृशम्शं वा",
          "meaning": "humane, or",
          "anvayaIndex": 3,
          "verseIndex": 1
        },
        {
          "itrans": "paatakam vaa",
          "iast": "pātakam vā",
          "devanagari": "पातकं वा",
          "meaning": "sinful, or",
          "anvayaIndex": 4,
          "verseIndex": 6
        },
        {
