          "verseIndex": 8
        },
        {
          "itrans": "vikR^ita aananaa",
          "iast": "vikṛta ānanā",
          "devanagari": "विकृत आनना",
          "meaning": "with contorted, faced",
          "anvayaIndex": 4,
          "verseIndex": 9
        },
        {
          "itrans": "puruSa adii",
          "iast": "puruṣa adī",
