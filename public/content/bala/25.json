          "iast": "strī vadha",
          "devanagari": "स्त्री वध",
          "meaning": "female, killing",
          "anvayaIndex": 1,
          "verseIndex": 3
        },
        {
          "itrans": "kR^ite ghR^iNaa",
          "iast": "kṛte ghṛṇā",
