        },
        {
          "itrans": "muneH tu vacanam shrutvaa",
          "iast": "muneḥ tu vacanam śrutvā",
          "devanagari": "मुनेः तु वचनं श्रुत्वा",
          "meaning": "of sage, but, words, on listening",
          "anvayaIndex": 2,
          "verseIndex": 0
        },
        {
