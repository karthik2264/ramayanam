          "iast": "kṛta anjali puṭe",
          "devanagari": "कृत अन्जलि पुटे",
          "meaning": "on making, adjoined palm's, planes",
          "anvayaIndex": 3,
          "verseIndex": null
        },
        {
          "itrans": "bhaaSamaaNam mahaatmaanam",
          "iast": "bhāṣamāṇam mahātmānam",
          "devanagari": "भाषमाणं महात्मानं",
          "meaning": "he who is saying thus, great-soul - Sage Bhrigu",
          "anvayaIndex": 4,
          "verseIndex": 0
        },
        {
          "itrans": "prasaadya",
          "iast": "prasādya",
          "devanagari": "प्रसाद्य",
          "meaning": "on gaining his grace",
          "anvayaIndex": 5,
          "verseIndex": 4
        },
        {
