    {
      "id": "1.38.9",
      "label": "1.38.9",
      "numbers": [
        9
      ],
      "devanagari": "भाषमाणं महात्मानं राजपुत्र्यौ प्रसाद्य तम् |\nऊचतुः परमप्रीते कृतांजलिपुटे तदा",
      "iast": "bhāṣamāṇam mahātmānam rāja putryau prasādya tam |\nūcatuḥ parama prīte kṛtāñjali puṭe tadā",
      "translation": "Highly gladdened are the daughters of kings of Vidarbha and Aristanemi, i.e., the queens of Sagara, and on making palm-fold in supplication at the sage who is speaking that way, and on gaining the grace of that sage they spoke to him.",
      "notes": [],
      "glosses": [
        {
          "itrans": "tadaa",
          "iast": "tadā",
          "devanagari": "तदा",
          "meaning": "then",
          "anvayaIndex": 0,
          "verseIndex": 11
        },
        {
          "itrans": "parama priite",
          "iast": "parama prīte",
          "devanagari": "परम प्रीते",
          "meaning": "highly, gladdened",
          "anvayaIndex": 1,
          "verseIndex": 7
        },
        {
          "itrans": "raaja putryau",
          "iast": "rāja putryau",
          "devanagari": "राज पुत्र्यौ",
          "meaning": "king's, daughters - queens of Sagara",
          "anvayaIndex": 2,
          "verseIndex": 2
        },
        {
