    {
      "id": "1.38.15",
      "label": "1.38.15",
      "numbers": [
        15
      ],
      "devanagari": "प्रदक्षिणमृषिं कृत्वा शिरसाभिप्रणम्य च |\nजगाम स्वपुरं राजा सभार्या रघुनन्दन",
      "iast": "pradakṣiṇam ṛṣim kṛtvā śirasā abhipraṇaṃya ca |\njagāma sva puram rājā sabhāryā raghu nandana",
      "translation": "\"On performing circumambulations to the Sage Bhrigu along with wives, oh, Raghu's scion, also on reverencing him head-bent, the king Sagara proceeded to his own city.",
      "notes": [],
      "glosses": [
        {
          "itrans": "raghu nandana",
          "iast": "raghu nandana",
          "devanagari": "रघु नन्दन",
