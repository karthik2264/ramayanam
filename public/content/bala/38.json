          "iast": "su mahān apatya labhaḥ bhaviṣyati",
          "devanagari": "सु महान् अपत्य लभः भविष्यति",
          "meaning": "very, admirable, progeny, achievement, will be there",
          "anvayaIndex": 2,
          "verseIndex": null
        },
        {
          "itrans": "puruSarSabha",
          "iast": "puruṣarṣabha",
          "devanagari": "पुरुषर्षभ",
