          "iast": "iha sthāne",
          "devanagari": "इह स्थाने",
          "meaning": "at this, place",
          "anvayaIndex": 7,
          "verseIndex": 13
        },
        {
          "itrans": "vishaala iti purii kR^itaa",
          "iast": "viśāla iti purī kṛtā",
          "devanagari": "विशाल इति पुरी कृता",
          "meaning": "Vishaala, as known as,] city, constructed",
          "anvayaIndex": 8,
          "verseIndex": 15
        },
        {
          "itrans": "aasiit",
          "iast": "āsīt",
          "devanagari": "आसीत्",
          "meaning": "is there.",
          "anvayaIndex": 9,
          "verseIndex": 12
        }
      ]
    },
    {
      "id": "1.47.13",
      "label": "1.47.13",
      "numbers": [
        13
      ],
      "devanagari": "विशालस्य सुतो राम हेमचन्द्रो महाबलः |\nसुचन्द्र इति विख्यातो हेमचन्द्रादनंतरः",
      "iast": "viśālasya suto rāma hemacandro mahābalaḥ |\nsucandra iti vikhyāto hemacandrāt anantaraḥ",
