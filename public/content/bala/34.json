    {
      "id": "1.34.7",
      "label": "1.34.7",
      "numbers": [
        7
      ],
      "devanagari": "पूर्वजा भगिनी चापि मम राघव सुव्रता |\nनाम्ना सत्यवती नाम ऋचीके प्रतिपादिता",
      "iast": "pūrvajā bhaginī ca api mama rāghava suvratā |\nnāmnā satyavatī nāma ṛcīke pratipāditā",
      "translation": "\"Even my elder sister who undertook benevolent vows and who is renowned by her name Satyavathi is there, oh, Raghava, and she is given in marriage to sage Ruchika.",
      "notes": [],
      "glosses": [
        {
          "itrans": "raaghava",
          "iast": "rāghava",
          "devanagari": "राघव",
          "meaning": "oh, Raghava",
          "anvayaIndex": 0,
          "verseIndex": 5
