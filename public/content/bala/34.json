          "anvayaIndex": 1,
          "verseIndex": 6
        },
        {
          "itrans": "naamnaa satyavatii naama",
          "iast": "nāmnā satyavatī nāma",
          "devanagari": "नाम्ना सत्यवती नाम",
          "meaning": "by name, Satyavati, renowned as",
