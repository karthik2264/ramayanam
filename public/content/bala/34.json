    {
      "id": "1.34.8",
      "label": "1.34.8",
      "numbers": [
        8
      ],
      "devanagari": "सशरीरा गता स्वर्गं भर्तारमनुवर्तिनी |\nकौशिकी परमोदारा सा प्रवृत्ता महानदी",
      "iast": "saśarīrā gatā svargam bhartāram anuvartinī |\nkauśikī paramodārā sā pravṛttā mahānadī",
      "translation": "\"She journeyed to heaven with her body while she followed her departed husband and being a very generous lady she coursed as a great river renowned as River Kaushiki.",
      "notes": [
        "Now called Kos'i (Cosy) corrupted from Kaus'ika, daughter of Kusha. 'This is one of those personifications of rivers so frequent in the Grecian mythology, but in the similar myths is seen the impress of the genius of each people, austere and profoundly religious in India, graceful and devoted to the worship of external beauty in Greece.' Gorresio."
      ],
      "glosses": [
        {
          "itrans": "saa",
          "iast": "sā",
          "devanagari": "सा",
          "meaning": "she",
          "anvayaIndex": 0,
          "verseIndex": 7
        },
        {
          "itrans": "bhartaaram anuvartinii",
          "iast": "bhartāram anuvartinī",
          "devanagari": "भर्तारं अनुवर्तिनी",
          "meaning": "husband, while following",
          "anvayaIndex": 1,
          "verseIndex": 3
        },
        {
          "itrans": "sa shariiraa svargam gataa",
          "iast": "sa śarīrā svargam gatā",
          "devanagari": "स शरीरा स्वर्गं गता",
          "meaning": "with body, to heaven, went to",
          "anvayaIndex": 2,
          "verseIndex": null
        },
        {
          "itrans": "parama udaaraa",
          "iast": "parama udārā",
          "devanagari": "परम उदारा",
          "meaning": "very, generous one",
          "anvayaIndex": 3,
          "verseIndex": null
        },
        {
          "itrans": "kaushikii",
          "iast": "kauśikī",
          "devanagari": "कौशिकी",
          "meaning": "[renowned as] Kaushiki",
          "anvayaIndex": 4,
          "verseIndex": 5
        },
        {
          "itrans": "saa mahaa nadii pravR^ittaa",
          "iast": "sā mahā nadī pravṛttā",
          "devanagari": "सा महा नदी प्रवृत्ता",
          "meaning": "she, as great, river, coursed as.",
          "anvayaIndex": 5,
          "verseIndex": null
        }
      ]
    },
    {
      "id": "1.34.9",
      "label": "1.34.9",
      "numbers": [
        9
      ],
      "devanagari": "दिव्या पुण्योदका रम्या हिमवन्तमुपाश्रिता |\nलोकस्य हितकार्यार्थं प्रवृत्ता भगिनी मम",
      "iast": "divyā puṇya udakā raṃyā himavantam upāśritā |\nlokasya hitakārya artham pravṛttā bhaginī mama",
      "translation": "\"Desiring to yield benefit for the welfare of world, my sister has emerged with her divinely pious and delightful waters, taking recourse to Himalayan Mountains.",
      "notes": [
        "If the first compound is <em>lokasya hita kāma artham</em> then 'to accord both mortal and immortal happiness; <em>pāra laukika, aihika saukhyam</em> . My sister's holy waves are hurled / To purify and glad the world. - Griffith."
      ],
      "glosses": [
        {
          "itrans": "lokasya hita kaarya artham",
          "iast": "lokasya hita kārya artham",
          "devanagari": "लोकस्य हित कार्य अर्थं",
          "meaning": "world's, welfare, to do [yield benefit,] desiring for",
          "anvayaIndex": 0,
          "verseIndex": 6
        },
        {
          "itrans": "pra vR^ittaa",
          "iast": "pra vṛttā",
          "devanagari": "प्र वृत्ता",
          "meaning": "well, emerged",
          "anvayaIndex": 1,
          "verseIndex": 9
        },
        {
