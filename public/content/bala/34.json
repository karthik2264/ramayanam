          "iast": "divyā puṇya udakā ramya",
          "devanagari": "दिव्या पुण्य उदका रम्य",
          "meaning": "divinely, pious, water, delightful",
          "anvayaIndex": 2,
          "verseIndex": 0
        },
        {
          "itrans": "mama bhaginii",
          "iast": "mama bhaginī",
