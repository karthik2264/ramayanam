          "verseIndex": 0
        },
        {
          "itrans": "dhiimataH kushanaabhasya",
          "iast": "dhīmataḥ kuśanābhasya",
          "devanagari": "धीमतः कुशनाभस्य",
          "meaning": "to highly intellectual, Kushanaabha",
          "anvayaIndex": 1,
