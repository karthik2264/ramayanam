          "devanagari": "सनत् कुमारः भगवान्",
          "meaning": "Sage Sanatkumara, godly one",
          "anvayaIndex": 3,
          "verseIndex": null
        },
        {
          "itrans": "puurvam kathitavaan kathaam",
