    {
      "id": "1.57.7",
      "label": "1.57.7",
      "numbers": [
        7
      ],
      "devanagari": "विश्वामित्रोऽपि तच्छ्रुत्वा ह्रिया किंचिदवाङ्मुखः\nदुःखेन महताविष्टः समन्युरिदमब्रवीत् |",
      "iast": "viśvāmitro api tat śrutvā hriyā kiñcit avāñmukhaḥ\nduḥkhena mahatā āviṣṭaḥ sa manyuḥ idam abravīt |",
      "translation": "\"On hearing that Vishvamitra is down-faced with disgrace, and while high anguish prevailed over him, he rancorously soliloquised this.",
      "notes": [],
      "glosses": [
        {
          "itrans": "vishvaamitraH api tat shrutvaa",
          "iast": "viśvāmitraḥ api tat śrutvā",
          "devanagari": "विश्वामित्रः अपि तत् श्रुत्वा",
          "meaning": "Vishvamitra, even, that, on hearing",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "hriyaa kincit avaa~N mukhaH",
          "iast": "hriyā kincit avāñ mukhaḥ",
          "devanagari": "ह्रिया किन्चित् अवाञ् मुखः",
          "meaning": "by disgrace, down, faced",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
          "itrans": "mahataa duHkhena aaviSTaH",
          "iast": "mahatā duḥkhena āviṣṭaḥ",
          "devanagari": "महता दुःखेन आविष्टः",
          "meaning": "with high, anguish, prevailing over",
          "anvayaIndex": 2,
          "verseIndex": 7
        },
        {
          "itrans": "sa manyuH idam abraviit",
          "iast": "sa manyuḥ idam abravīt",
          "devanagari": "स मन्युः इदं अब्रवीत्",
          "meaning": "with, rancour, this, spoke [soliloquised.]",
          "anvayaIndex": 3,
          "verseIndex": 10
        }
      ]
    },
    {
      "id": "1.57.8",
      "label": "1.57.8",
      "numbers": [
        8
      ],
      "devanagari": "तपश्च सुमहत्तप्तं राजर्षिरिति मां विदुः\nदेवाः सर्षिगणाः सर्वे नास्ति मन्ये तपःफलम् |",
      "iast": "tapaḥ ca sumahat taptam rāja ṛṣir iti mām viduḥ\ndevāḥ sa ṛṣi gaṇāḥ sarve na asti manye tapaḥ phalam |",
      "translation": "\" 'Even though I have practised a very high ascesis, the gods together with the observances of hermits are recognising me just as a 'kingly-sage.' Thereby I deem that there is no fruition to my ascesis.' Thus Vishvamitra thought. [8b, 9a]",
      "notes": [],
      "glosses": [
        {
          "itrans": "su mahat tapaH taptam",
          "iast": "su mahat tapaḥ taptam",
          "devanagari": "सु महत् तपः तप्तं",
          "meaning": "very, high, practised [even though]",
          "anvayaIndex": 0,
          "verseIndex": null
        },
        {
          "itrans": "maam raaja R^iSiH iti",
          "iast": "mām rāja ṛṣiḥ iti",
          "devanagari": "मां राज ऋषिः इति",
          "meaning": "me, kingly, sage, thus as",
          "anvayaIndex": 1,
          "verseIndex": 4
        },
        {
          "itrans": "sa R^iSi gaNaaH sarve devaaH",
          "iast": "sa ṛṣi gaṇāḥ sarve devāḥ",
          "devanagari": "स ऋषि गणाः सर्वे देवाः",
          "meaning": "with, hermits' observances, all, gods",
          "anvayaIndex": 2,
          "verseIndex": 9
        },
        {
