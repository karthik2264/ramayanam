          "iast": "aham",
          "devanagari": "अहं",
          "meaning": "I",
          "anvayaIndex": 1,
          "verseIndex": 3
        },
        {
          "itrans": "sharaNyaan",
          "iast": "śaraṇyān",
          "devanagari": "शरण्यान्",
          "meaning": "you shelterers - of the needy",
          "anvayaIndex": 2,
          "verseIndex": 4
        },
        {
          "itrans": "vaH",
          "iast": "vaḥ",
          "devanagari": "वः",
          "meaning": "you",
          "anvayaIndex": 3,
          "verseIndex": 1
        },
        {
          "itrans": "sharaNam prapadye",
          "iast": "śaraṇam prapadye",
          "devanagari": "शरणं प्रपद्ये",
