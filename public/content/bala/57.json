          "iast": "viduḥ",
          "devanagari": "विदुः",
          "meaning": "are recognising",
          "anvayaIndex": 3,
          "verseIndex": 8
        },
        {
          "itrans": "tapaH phalam na asti manye",
          "iast": "tapaḥ phalam na asti manye",
          "devanagari": "तपः फलं न अस्ति मन्ये",
          "meaning": "of ascesis, fruition, not, is there, I deem.",
          "anvayaIndex": 4,
          "verseIndex": 14
        }
      ]
    },
    {
      "id": "1.57.9",
      "label": "1.57.9",
      "numbers": [
        9
      ],
      "devanagari": "एवं निश्चित्य मनसा भूय एव महातपाः\nतपश्चचार काकुत्स्थ परमं परमात्मवान् |",
      "iast": "evam niścitya manasā bhūya eva mahātapāḥ\ntapaḥ cacāra kākutstha paramam parama ātmavān |",
      "translation": "\"Oh, Rama of Kakutstha, deciding in this way in his heart of hearts that self-willed Vishvamitra again undertook a supreme ascesis as he is a great-ascetic.",
      "notes": [],
      "glosses": [
        {
          "itrans": "kaakutstha",
          "iast": "kākutstha",
          "devanagari": "काकुत्स्थ",
          "meaning": "oh, Rama of Kakutstha",
          "anvayaIndex": 0,
          "verseIndex": 8
        },
        {
          "itrans": "mahaatapaaH",
          "iast": "mahātapāḥ",
          "devanagari": "महातपाः",
          "meaning": "great-ascetic",
          "anvayaIndex": 1,
          "verseIndex": 5
        },
        {
          "itrans": "parama aatmavaan",
