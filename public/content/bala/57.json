          "meaning": "to all of them, thus, to great-souled ones",
          "anvayaIndex": 9,
          "verseIndex": 2
        },
        {
          "itrans": "saH abraviit",
          "iast": "saḥ abravīt",
          "devanagari": "सः अब्रवीत्",
