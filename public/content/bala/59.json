      "notes": [],
      "glosses": [
        {
          "itrans": "guru shaapa kR^itam",
          "iast": "guru śāpa kṛtam",
          "devanagari": "गुरु शाप कृतं",
          "meaning": "by mentor, curse, made",
          "anvayaIndex": 0,
