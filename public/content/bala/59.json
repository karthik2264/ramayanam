          "meaning": "then, oh, king",
          "anvayaIndex": 4,
          "verseIndex": 10
        },
        {
          "itrans": "nirvR^itaH yakSyasi",
          "iast": "nirvṛtaḥ yakṣyasi",
          "devanagari": "निर्वृतः यक्ष्यसि",
          "meaning": "composedly, you can perform ritual.",
          "anvayaIndex": 5,
