      "glosses": [
        {
          "itrans": "ikSvaakoH vatsa",
          "iast": "ikṣvākoḥ vatsa",
          "devanagari": "इक्ष्वाकोः वत्स",
          "meaning": "oh, Ikshvaku-s, progeny, [oh, Trishanku]",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "svaagatam",
          "iast": "svāgatam",
          "devanagari": "स्वागतं",
          "meaning": "welcome",
          "anvayaIndex": 1,
          "verseIndex": 1
