          "devanagari": "त्वां सु धार्मिकं जानामि",
          "meaning": "you, as highly, righteous [king,] I am aware",
          "anvayaIndex": 2,
          "verseIndex": null
        },
        {
          "itrans": "nR^ipa pungava",
          "iast": "nṛpa pungava",
          "devanagari": "नृप पुन्गव",
          "meaning": "oh, king, the best",
          "anvayaIndex": 3,
          "verseIndex": 11
        },
        {
          "itrans": "maa bhaiSiiH",
          "iast": "mā bhaiṣīḥ",
          "devanagari": "मा भैषीः",
          "meaning": "do not, fear",
          "anvayaIndex": 4,
          "verseIndex": 9
        },
        {
          "itrans": "[aham",
          "iast": "[aham",
          "devanagari": "[अहं",
          "meaning": "I]",
          "anvayaIndex": 5,
          "verseIndex": null
