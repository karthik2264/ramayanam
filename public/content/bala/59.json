      "glosses": [
        {
          "itrans": "8b, 9a: anyaH",
          "iast": "8b, 9a: anyaḥ",
          "devanagari": "8ब्, 9अ: अन्यः",
          "meaning": "other [someone]",
          "anvayaIndex": 0,
          "verseIndex": null
        },
        {
