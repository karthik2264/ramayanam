        {
          "itrans": "dhiimataa",
          "iast": "dhīmatā",
          "devanagari": "धीमता",
          "meaning": "by the intellectual one",
          "anvayaIndex": 1,
          "verseIndex": 6
        },
        {
          "itrans": "sahasra akSeNa",
          "iast": "sahasra akṣeṇa",
          "devanagari": "सहस्र अक्षेण",
