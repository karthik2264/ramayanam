          "iast": "kopena",
          "devanagari": "कोपेन",
          "meaning": "by angering",
          "anvayaIndex": 2,
          "verseIndex": 0
        },
        {
          "itrans": "tapaH apaharaNe kR^ite",
          "iast": "tapaḥ apaharaṇe kṛte",
          "devanagari": "तपः अपहरणे कृते",
          "meaning": "ascetical [merit,] in divesture of, made [owing to]",
          "anvayaIndex": 3,
          "verseIndex": 3
        },
        {
          "itrans": "a jitai indriyaiH",
          "iast": "a jitai indriyaiḥ",
          "devanagari": "अ जितै इन्द्रियैः",
          "meaning": "not, governable, with senses",
          "anvayaIndex": 4,
