      "glosses": [
        {
          "itrans": "saa tasya vacanam shrutvaa",
          "iast": "sā tasya vacanam śrutvā",
          "devanagari": "सा तस्य वचनं श्रुत्वा",
          "meaning": "she, his [Indra's,] sentence, on hearing",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "an uttamam ruupam kR^itvaa",
          "iast": "an uttamam rūpam kṛtvā",
          "devanagari": "अन् उत्तमं रूपं कृत्वा",
          "meaning": "un, excelled, physique, on adopting",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
          "itrans": "lalitaa",
          "iast": "lalitā",
          "devanagari": "ललिता",
          "meaning": "lovely lady",
          "anvayaIndex": 2,
          "verseIndex": 8
        },
        {
          "itrans": "shuci smitaa",
          "iast": "śuci smitā",
          "devanagari": "शुचि स्मिता",
          "meaning": "bight, smiles [with giggly grins]",
          "anvayaIndex": 3,
          "verseIndex": 10
        },
        {
          "itrans": "vishvaamitram lobhayaamaasa",
          "iast": "viśvāmitram lobhayāmāsa",
          "devanagari": "विश्वामित्रं लोभयामास",
          "meaning": "Vishvamitra, she started to entice.",
          "anvayaIndex": 4,
          "verseIndex": 7
        }
      ]
