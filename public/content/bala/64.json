        {
          "itrans": "valgu vyaaharataH",
          "iast": "valgu vyāharataḥ",
          "devanagari": "वल्गु व्याहरतः",
          "meaning": "melodiously, saying [trilling]",
          "anvayaIndex": 1,
          "verseIndex": 3
        },
        {
          "itrans": "kokilasya svanam shushraava",
          "iast": "kokilasya svanam śuśrāva",
          "devanagari": "कोकिलस्य स्वनं शुश्राव",
          "meaning": "songbird's, tune, he heard",
          "anvayaIndex": 2,
          "verseIndex": null
        },
        {
          "itrans": "[tataH",
          "iast": "[tataḥ",
