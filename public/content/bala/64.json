          "iast": "rambhe",
          "devanagari": "रम्भे",
          "meaning": "oh, Rambha",
          "anvayaIndex": 1,
          "verseIndex": 3
        },
        {
          "itrans": "kaama krodha jaya eSiNam",
          "iast": "kāma krodha jaya eṣiṇam",
          "devanagari": "काम क्रोध जय एषिणं",
          "meaning": "wonton, wroth, to win over, wisher",
          "anvayaIndex": 2,
          "verseIndex": 4
        },
        {
