    {
      "id": "1.64.5",
      "label": "1.64.5, 6",
      "numbers": [
        5,
        6
      ],
      "devanagari": "मा भैषि रंभे भद्रं ते कुरुष्व मम शासनम्\nकोकिलो हृदयग्राही माधवे रुचिरद्रुमे |\nअहं कंदर्पसहितः स्थास्यामि तव पार्श्वतः",
      "iast": "mā bhaiṣī rambhe bhadram te kuruṣva mama śāsanam\nkokilo hṛdaya grāhī mādhave rucira drume |\naham kandarpa sahitaḥ sthāsyāmi tava pārśvataḥ",
      "translation": "\" 'You need not be fearful, Rambha, carry out my command, safe betides you, I on becoming a heart-stealing black-songbird will be at your side along with Love-god in the pleasing trees of springtime.",
      "notes": [],
      "glosses": [
        {
          "itrans": "rambhe",
          "iast": "rambhe",
          "devanagari": "रम्भे",
          "meaning": "oh, Rambha",
          "anvayaIndex": 0,
          "verseIndex": 2
        },
        {
          "itrans": "maa bhaiSii",
          "iast": "mā bhaiṣī",
          "devanagari": "मा भैषी",
          "meaning": "you need not, be fearful",
          "anvayaIndex": 1,
          "verseIndex": 0
        },
        {
          "itrans": "te bhadram",
          "iast": "te bhadram",
          "devanagari": "ते भद्रं",
          "meaning": "you, will be safe",
          "anvayaIndex": 2,
          "verseIndex": 3
        },
        {
          "itrans": "mama shaasanam kuruSva",
          "iast": "mama śāsanam kuruṣva",
          "devanagari": "मम शासनं कुरुष्व",
          "meaning": "my, command, you carryout",
          "anvayaIndex": 3,
          "verseIndex": 5
        },
