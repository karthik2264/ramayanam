        },
        {
          "itrans": "vaakyam abraviit",
          "iast": "vākyam abravīt",
          "devanagari": "वाक्यं अब्रवीत्",
          "meaning": "words, said.",
          "anvayaIndex": 6,
          "verseIndex": 11
        }
      ]
    },
    {
      "id": "1.21.6",
      "label": "1.21.6",
      "numbers": [
        6
      ],
      "devanagari": "इक्ष्वाकूणां कुले जातः साक्षाद्धर्म इवापरः |\nधृतिमान् सुव्रतः श्रीमान्न धर्मं हातुमर्हसि",
      "iast": "ikṣvākūṇām kule jātaḥ sākṣāt dharma iva aparaḥ |\ndhṛtimān suvrataḥ śrīmān na dharmam hātum arhasi",
      "translation": "\"Born in Ikshwaku dynasty you are apparently the other god of ethics on earth, a staunch one with righteous vows and a glorious one too, such as you are, it will be unapt of you to forsake ethics.\"",
      "notes": [],
      "glosses": [
        {
          "itrans": "ikshwaakuuNaam kule jaataH",
          "iast": "ikśvākūṇām kule jātaḥ",
          "devanagari": "इक्श्वाकूणां कुले जातः",
          "meaning": "in Ikshwaku, dynasty, born [are you]",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "saakshaat aparaH dharam iva",
          "iast": "sākśāt aparaḥ dharam iva",
          "devanagari": "साक्शात् अपरः धरं इव",
          "meaning": "apparently, another, god of ethics, [you are] like",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
