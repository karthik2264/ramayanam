    {
      "id": "1.21.13",
      "label": "1.21.13",
      "numbers": [
        13
      ],
      "devanagari": "सर्वास्त्राणि कृशाश्वस्य पुत्राः परमधार्मिकाः |\nकौशिकाय पुरा दत्ता यदा राज्यं प्रशासति",
      "iast": "sarva astrāṇi kṛśāśvasya putrāḥ parama dhārmikāḥ |\nkauśikāya purā dattā yadā rājyam praśāsati",
      "translation": "\"All the missiles known to Vishvamitra are the highly righteous children of Krishaasva Prajapati, where Prajapati-s were the earliest ruler of mankind, and god Shiva gave them to Vishvamitra when was ruling kingdom.",
      "notes": [],
      "glosses": [
        {
          "itrans": "kR^ishaasvasya",
          "iast": "kṛśāsvasya",
          "devanagari": "कृशास्वस्य",
          "meaning": "Krishaasva's parama dhaarmikaaH putraaH = highly righteous, sons",
          "anvayaIndex": 0,
          "verseIndex": 2
        },
        {
          "itrans": "sarva astraaaNi",
          "iast": "sarva astrāaṇi",
          "devanagari": "सर्व अस्त्राअणि",
          "meaning": "all, missiles [known to Vishvamitra] are",
          "anvayaIndex": 1,
          "verseIndex": 0
        },
        {
          "itrans": "yadaa puraaa raajyam prashaasati",
          "iast": "yadā purāa rājyam praśāsati",
          "devanagari": "यदा पुराअ राज्यं प्रशासति",
          "meaning": "when, earlier, kingdom, he was ruling",
          "anvayaIndex": 2,
          "verseIndex": 7
        },
        {
          "itrans": "kaushikaaya datta",
          "iast": "kauśikāya datta",
          "devanagari": "कौशिकाय दत्त",
          "meaning": "to Kaushuka - Viswamitra, they were given [by god Shiva.]",
          "anvayaIndex": 3,
          "verseIndex": 6
        }
      ]
    },
    {
      "id": "1.21.14",
      "label": "1.21.14",
      "numbers": [
        14
      ],
      "devanagari": "तेऽपि पुत्रा कृशाश्वस्य प्रजापतिसुतासुताः |\nनैकरूपा महावीर्या दीप्तिमंतो जयावहाः",
      "iast": "te api putrā kṛśāśvasya prajāpati sutā sutāḥ |\nna eka rūpā mahāvīryā dīptimanto jayāvahāḥ",
      "translation": "\"Those missiles are the sons of Daksha Prajaapati's daughters and her husband Krishaasva Prajapati, and they are disparate in their form, intrepid, dazzling, and victory-oriented missiles.",
      "notes": [],
      "glosses": [
        {
          "itrans": "prajaapati sutaa sutaaH",
          "iast": "prajāpati sutā sutāḥ",
