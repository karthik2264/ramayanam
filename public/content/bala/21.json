        {
          "itrans": "na eka ruupa",
          "iast": "na eka rūpa",
          "devanagari": "न एक रूप",
          "meaning": "not, in one, form - disparate",
          "anvayaIndex": 3,
          "verseIndex": 7
        },
        {
          "itrans": "maha viiryaa",
          "iast": "maha vīryā",
          "devanagari": "मह वीर्या",
          "meaning": "very, intrepid ones",
          "anvayaIndex": 4,
          "verseIndex": 10
        },
        {
          "itrans": "diiptimantaH",
          "iast": "dīptimantaḥ",
          "devanagari": "दीप्तिमन्तः",
          "meaning": "dazzling",
          "anvayaIndex": 5,
          "verseIndex": null
        },
        {
          "itrans": "jayaa vahaa",
          "iast": "jayā vahā",
          "devanagari": "जया वहा",
          "meaning": "victory, carriers of.",
          "anvayaIndex": 6,
          "verseIndex": 12
        }
      ]
