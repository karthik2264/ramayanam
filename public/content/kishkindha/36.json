        }
      ]
    },
    {
      "id": "4.36.9",
      "label": "4.36.9",
      "numbers": [
        9
      ],
      "devanagari": "धनुर् विस्फारमाणस्य यस्य शब्देन लक्ष्मण |\nस शैला कम्पिता भूमिः सहायैः किम् नु तस्य वै",
      "iast": "dhanur visphāramāṇasya yasya śabdena lakṣmaṇa |\nsa śailā kampitā bhūmiḥ sahāyaiḥ kim nu tasya vai",
      "translation": "\"He who outstretches his bow with a clangour by which the earth with its mountains quakes, oh, Lakshmana, to him these aides are really of what aid, indeed!",
      "notes": [],
      "glosses": [
        {
          "itrans": "lakSmaNa",
          "iast": "lakṣmaṇa",
          "devanagari": "लक्ष्मण",
          "meaning": "oh, Lakshmana",
          "anvayaIndex": 0,
          "verseIndex": 4
        },
        {
          "itrans": "dhanuH visphaaramaaNasya",
          "iast": "dhanuḥ visphāramāṇasya",
          "devanagari": "धनुः विस्फारमाणस्य",
          "meaning": "bow, to one who is outstretching it",
          "anvayaIndex": 1,
          "verseIndex": 0
        },
        {
          "itrans": "yasya",
          "iast": "yasya",
          "devanagari": "यस्य",
          "meaning": "whose - Rama's",
          "anvayaIndex": 2,
          "verseIndex": 2
        },
        {
          "itrans": "shabdena",
          "iast": "śabdena",
          "devanagari": "शब्देन",
