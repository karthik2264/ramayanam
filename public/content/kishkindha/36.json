          "iast": "tvām ca",
          "devanagari": "त्वां च",
          "meaning": "you, also",
          "anvayaIndex": 2,
          "verseIndex": 11
        },
        {
          "itrans": "varjayitvaa",
          "iast": "varjayitvā",
          "devanagari": "वर्जयित्वा",
          "meaning": "leaving alone",
          "anvayaIndex": 3,
          "verseIndex": 7
        },
        {
