          "devanagari": "सर्वथा",
          "meaning": "in anyway",
          "anvayaIndex": 5,
          "verseIndex": 0
        },
        {
          "itrans": "sa naathaH",
          "iast": "sa nāthaḥ",
          "devanagari": "स नाथः",
          "meaning": "is together with, a defender",
          "anvayaIndex": 6,
          "verseIndex": 4
        },
        {
