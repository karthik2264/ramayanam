          "meaning": "great-souled one, his, of Sugreeva",
          "anvayaIndex": 0,
          "verseIndex": null
        },
        {
          "itrans": "iti bruvaaNasya",
          "iast": "iti bruvāṇasya",
          "devanagari": "इति ब्रुवाणस्य",
