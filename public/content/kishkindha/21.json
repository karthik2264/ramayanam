          "anvayaIndex": 0,
          "verseIndex": 6
        },
        {
          "itrans": "kumaaraH ayam angadaH draSTavyaH",
          "iast": "kumāraḥ ayam angadaḥ draṣṭavyaḥ",
          "devanagari": "कुमारः अयं अन्गदः द्रष्टव्यः",
          "meaning": "young one, this, Angada, is to be looked after",
          "anvayaIndex": 1,
          "verseIndex": 1
        },
        {
          "itrans": "aayatyaa ca",
          "iast": "āyatyā ca",
          "devanagari": "आयत्या च",
          "meaning": "forthcoming - ensuing, also",
          "anvayaIndex": 2,
          "verseIndex": 8
        },
        {
          "itrans": "asya vidheyaani samarthaani",
          "iast": "asya vidheyāni samarthāni",
          "devanagari": "अस्य विधेयानि समर्थानि",
          "meaning": "by him, deeds of duty [funerals of Vali,] deeds for well-being",
          "anvayaIndex": 3,
          "verseIndex": 10
        },
        {
          "itrans": "cintaya",
          "iast": "cintaya",
          "devanagari": "चिन्तय",
          "meaning": "are to be thought of.",
          "anvayaIndex": 4,
          "verseIndex": 13
        }
      ]
    },
    {
      "id": "4.21.5",
      "label": "4.21.5",
      "numbers": [
        5
      ],
      "devanagari": "जानासि अनियताम् एवम् भूतानाम् आगतिम् गतिम् |\nतस्मात् शुभम् हि कर्तव्यम् पण्डितेन इह लौकिकम्",
      "iast": "jānāsi aniyatām evam bhūtānām āgatim gatim |\ntasmāt śubham hi kartavyam paṇḍitena iha laukikam",
      "translation": "\"You are aware that the coming and going of beings, in their subtle forms of earth, water, fire, air and space into this mortal life and back is uncertain, thereby the prudent ones have to perform auspicious worldly deeds here in this world, say, the funeral of Vali.",
      "notes": [],
      "glosses": [
        {
          "itrans": "bhuutaanaam aagatim gatim",
          "iast": "bhūtānām āgatim gatim",
          "devanagari": "भूतानां आगतिं गतिं",
          "meaning": "living being's, coming, going [birth and death]",
          "anvayaIndex": 0,
          "verseIndex": 3
        },
        {
          "itrans": "a niyataam evam",
          "iast": "a niyatām evam",
          "devanagari": "अ नियतां एवं",
