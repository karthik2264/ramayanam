          "anvayaIndex": 1,
          "verseIndex": 1
        },
        {
          "itrans": "jaanaasi",
          "iast": "jānāsi",
          "devanagari": "जानासि",
          "meaning": "you are aware",
          "anvayaIndex": 2,
          "verseIndex": 0
        },
        {
          "itrans": "tasmaat",
