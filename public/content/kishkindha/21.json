          "iast": "sarvam tat",
          "devanagari": "सर्वं तत्",
          "meaning": "all, that",
          "anvayaIndex": 3,
          "verseIndex": null
        },
        {
          "itrans": "shubha a shubham karma",
          "iast": "śubha a śubham karma",
          "devanagari": "शुभ अ शुभं कर्म",
          "meaning": "good, not, good, deed",
          "anvayaIndex": 4,
          "verseIndex": null
        },
        {
          "itrans": "pretya",
          "iast": "pretya",
          "devanagari": "प्रेत्य",
          "meaning": "on demise",
          "anvayaIndex": 5,
          "verseIndex": 12
        },
