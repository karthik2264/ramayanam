    {
      "id": "4.21.7",
      "label": "4.21.7",
      "numbers": [
        7
      ],
      "devanagari": "यद् अयम् न्याय दृष्ट अर्थः साम दान क्षमा परः |\nगतो धर्म जिताम् भूमिम् न एनम् शोचितुम् अर्हसि",
      "iast": "yad ayam nyāya dṛṣṭa arthaḥ sāma dāna kṣamā paraḥ |\ngato dharma jitām bhūmim na enam śocitum arhasi",
      "translation": "\"By which reason this Vali conducted himself judiciously, observing friendliness, courteousness and forgivingness, by that reason alone Vali is going to a domain in heavens which he righteously conquered for himself, and it is unapt of your sorrowing for him.",
      "notes": [],
      "glosses": [
        {
          "itrans": "nyaaya dR^iSTa arthaH",
          "iast": "nyāya dṛṣṭa arthaḥ",
          "devanagari": "न्याय दृष्ट अर्थः",
          "meaning": "by justice, observed, having means - one who is observant of rationality, conducted himself judiciously",
          "anvayaIndex": 0,
          "verseIndex": 2
        },
        {
          "itrans": "saama daana kSamaa paraH",
          "iast": "sāma dāna kṣamā paraḥ",
          "devanagari": "साम दान क्षमा परः",
          "meaning": "friendliness, courteousness, forgivingness he was observing",
          "anvayaIndex": 1,
          "verseIndex": 5
        },
        {
          "itrans": "ayam",
          "iast": "ayam",
          "devanagari": "अयं",
          "meaning": "this Vali",
          "anvayaIndex": 2,
          "verseIndex": 1
        },
        {
          "itrans": "yat",
          "iast": "yat",
          "devanagari": "यत्",
          "meaning": "by which reason",
          "anvayaIndex": 3,
          "verseIndex": null
        },
        {
          "itrans": "dharma jitaam bhuumim gataH",
          "iast": "dharma jitām bhūmim gataḥ",
          "devanagari": "धर्म जितां भूमिं गतः",
          "meaning": "by rightness, conquered, to domain, has gone",
          "anvayaIndex": 4,
          "verseIndex": 9
        },
        {
          "itrans": "na enam shocitum arhasi",
          "iast": "na enam śocitum arhasi",
          "devanagari": "न एनं शोचितुं अर्हसि",
          "meaning": "not, for him, your sorrowing, apt of you.",
          "anvayaIndex": 5,
          "verseIndex": 13
        }
      ]
