      "glosses": [
        {
          "itrans": "plavaga rSabhaH",
          "iast": "plavaga rṣabhaḥ",
          "devanagari": "प्लवग र्षभः",
          "meaning": "of fly-jumper, the best one",
          "anvayaIndex": 0,
          "verseIndex": 5
        },
        {
          "itrans": "raajaa sugriivaH",
          "iast": "rājā sugrīvaḥ",
          "devanagari": "राजा सुग्रीवः",
          "meaning": "king [of monkeys,] Sugreeva",
          "anvayaIndex": 1,
          "verseIndex": null
