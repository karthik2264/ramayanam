        }
      ]
    },
    {
      "id": "4.57.10",
      "label": "4.57.10",
      "numbers": [
        10
      ],
      "devanagari": "रावणम् विरथम् कृत्वा स्थापयित्वा च मैथिलीम् |\nपरिश्रान्तः च वृद्धः च रावणेन हतो रणे",
      "iast": "rāvaṇam viratham kṛtvā sthāpayitvā ca maithilīm |\npariśrāntaḥ ca vṛddhaḥ ca rāvaṇena hato raṇe",
      "translation": "\"Jatayu is overly tired when he made Ravana's chariot defective and withheld Maithili from abduction as he is senescent, then Ravana killed him in that conflict... [4-57-10b, c]",
      "notes": [],
      "glosses": [
        {
          "itrans": "10b, c. raavaNam vi ratham kR^itvaa",
          "iast": "10b, c. rāvaṇam vi ratham kṛtvā",
          "devanagari": "10ब्, च्. रावणं वि रथं कृत्वा",
          "meaning": "Ravana is, without [defective,] chariot, on making",
          "anvayaIndex": 0,
          "verseIndex": null
        },
        {
          "itrans": "sthaapayitvaa ca maithiliim",
          "iast": "sthāpayitvā ca maithilīm",
          "devanagari": "स्थापयित्वा च मैथिलीं",
          "meaning": "on holding over, even, Maithili [from abduction]",
          "anvayaIndex": 1,
          "verseIndex": 3
        },
        {
          "itrans": "pari shraantaH ca",
          "iast": "pari śrāntaḥ ca",
          "devanagari": "परि श्रान्तः च",
          "meaning": "overly, tired, also",
          "anvayaIndex": 2,
          "verseIndex": 6
        },
        {
          "itrans": "vR^iddhaH ca",
          "iast": "vṛddhaḥ ca",
          "devanagari": "वृद्धः च",
          "meaning": "being old",
          "anvayaIndex": 3,
          "verseIndex": 8
        },
        {
          "itrans": "raNe raavaNena hataH",
          "iast": "raṇe rāvaṇena hataḥ",
          "devanagari": "रणे रावणेन हतः",
          "meaning": "in confrontation, by Ravana, killed.",
          "anvayaIndex": 4,
          "verseIndex": 10
        }
      ]
    },
    {
      "id": "4.57.11",
      "label": "4.57.11",
      "numbers": [
        11
      ],
      "devanagari": "एवम् गृध्रो हतः तेन रावणेन बलीयसा |\nसंस्कृतः च अपि रामेण गतः च गतिम् उत्तमाम्",
      "iast": "evam gṛdhro hataḥ tena rāvaṇena balīyasā |\nsaṃskṛtaḥ ca api rāmeṇa gataḥ ca gatim uttamām",
      "translation": "\"Thus that eagle was killed by that mighty Ravana, but solemnised by the obsequies performed by Rama, he departed on a sublime avenue to heavens...",
      "notes": [],
      "glosses": [
        {
          "itrans": "gR^idhraH",
          "iast": "gṛdhraḥ",
          "devanagari": "गृध्रः",
          "meaning": "eagle",
          "anvayaIndex": 0,
          "verseIndex": 1
        },
        {
          "itrans": "evam",
          "iast": "evam",
          "devanagari": "एवं",
          "meaning": "in this way",
          "anvayaIndex": 1,
          "verseIndex": 0
        },
        {
          "itrans": "baliiyasaa tena raavaNena hataH",
          "iast": "balīyasā tena rāvaṇena hataḥ",
          "devanagari": "बलीयसा तेन रावणेन हतः",
          "meaning": "by mighty, by him, by Ravana, is killed",
          "anvayaIndex": 2,
          "verseIndex": 2
        },
        {
          "itrans": "raameNa sanskR^itaH ca api",
          "iast": "rāmeṇa sanskṛtaḥ ca api",
          "devanagari": "रामेण सन्स्कृतः च अपि",
          "meaning": "by Rama, solemnised by [performed], obsequies, also, even",
          "anvayaIndex": 3,
          "verseIndex": null
        },
        {
          "itrans": "uttamaam gatim gataH",
          "iast": "uttamām gatim gataḥ",
          "devanagari": "उत्तमां गतिं गतः",
          "meaning": "sublime, on avenue, he departed.",
          "anvayaIndex": 4,
          "verseIndex": 11
        }
      ]
    },
    {
      "id": "4.57.12",
      "label": "4.57.12, 13",
      "numbers": [
        12,
        13
      ],
      "devanagari": "ततो मम पितृव्येण सुग्रीवेण महात्मना |\nचकार राघवः सख्यम् सः अवधीत् पितरम् मम\nमम पित्रा विरुद्धो हि सुग्रीवः सचिवैः सह |\nनिहत्य वालिनम् रामः ततः तम् अभिषेचयत्",
      "iast": "tato mama pitṛvyeṇa sugrīveṇa mahātmanā |\ncakāra rāghavaḥ sakhyam saḥ avadhīt pitaram mama\nmama pitrā viruddho hi sugrīvaḥ sacivaiḥ saha |\nnihatya vālinam rāmaḥ tataḥ tam abhiṣecayat",
      "translation": "\"Then Raghava made friendship with my paternal uncle Sugreeva, an intellectual autocrat, and Sugreeva got my father killed. Since Sugreeva antagonised my father, my father interdicted him along with his ministers, and Rama killed my father Vali and anointed Sugreeva...",
      "notes": [],
      "glosses": [
        {
          "itrans": "tataH raaghavaH mama pitR^ivyeNa",
          "iast": "tataḥ rāghavaḥ mama pitṛvyeṇa",
          "devanagari": "ततः राघवः मम पितृव्येण",
          "meaning": "then, Raghava, with my, paternal uncle",
          "anvayaIndex": 0,
          "verseIndex": null
        },
        {
          "itrans": "mahaa aatmanaa sugriiveNa sakhyam cakaara",
          "iast": "mahā ātmanā sugrīveṇa sakhyam cakāra",
          "devanagari": "महा आत्मना सुग्रीवेण सख्यं चकार",
          "meaning": "with great-souled [intellectual autocrat,] with Sugreeva, made, friendship",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
          "itrans": "saH mama pitaram avadhiit",
          "iast": "saḥ mama pitaram avadhīt",
          "devanagari": "सः मम पितरं अवधीत्",
          "meaning": "he [Sugreeva,] my, father, got killed",
          "anvayaIndex": 2,
          "verseIndex": 8
        },
        {
          "itrans": "sugriivaH sacivaiH saha",
          "iast": "sugrīvaḥ sacivaiḥ saha",
          "devanagari": "सुग्रीवः सचिवैः सह",
          "meaning": "Sugreeva, ministers, along with",
          "anvayaIndex": 3,
          "verseIndex": 16
        },
        {
          "itrans": "mama pitraa viruddhaH",
          "iast": "mama pitrā viruddhaḥ",
          "devanagari": "मम पित्रा विरुद्धः",
          "meaning": "with my, father, antagonised",
          "anvayaIndex": 4,
          "verseIndex": 12
        },
        {
          "itrans": "raamaH vaalinam nihatya",
          "iast": "rāmaḥ vālinam nihatya",
          "devanagari": "रामः वालिनं निहत्य",
          "meaning": "Rama, Vali, on killing",
          "anvayaIndex": 5,
          "verseIndex": 19
        }
      ]
    },
    {
      "id": "4.57.14",
      "label": "4.57.14",
      "numbers": [
        14
      ],
      "devanagari": "स राज्ये स्थापितः तेन सुग्रीवो वानरेश्वरः |\nराजा वानर मुख्यानाम् तेन प्रस्थापिता वयम्",
      "iast": "sa rājye sthāpitaḥ tena sugrīvo vānareśvaraḥ |\nrājā vānara mukhyānām tena prasthāpitā vayam",
      "translation": "\"Rama enthroned Sugreeva as the ruler of all vanara-s and that king of all vanara chiefs expedited all of us...",
      "notes": [],
      "glosses": [
        {
          "itrans": "tena raajye sthaapitaH",
          "iast": "tena rājye sthāpitaḥ",
          "devanagari": "तेन राज्ये स्थापितः",
          "meaning": "by him [by Rama,] in kingdom, established [enthroned]",
          "anvayaIndex": 0,
          "verseIndex": 1
        },
        {
          "itrans": "vaanara iishvaraH saH sugriivaH",
          "iast": "vānara īśvaraḥ saḥ sugrīvaḥ",
          "devanagari": "वानर ईश्वरः सः सुग्रीवः",
          "meaning": "vanara-s', ruler, he, that Sugreeva",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
          "itrans": "vaanara mukhyaanaam raajaa",
          "iast": "vānara mukhyānām rājā",
          "devanagari": "वानर मुख्यानां राजा",
          "meaning": "of [all] vanara, chiefs, he is the king",
          "anvayaIndex": 2,
          "verseIndex": 6
        },
        {
          "itrans": "tena vayam prasthaapitaa",
          "iast": "tena vayam prasthāpitā",
          "devanagari": "तेन वयं प्रस्थापिता",
          "meaning": "by him, we all are, expedited.",
          "anvayaIndex": 3,
          "verseIndex": 9
        }
      ]
    },
    {
      "id": "4.57.15",
      "label": "4.57.15",
      "numbers": [
        15
      ],
      "devanagari": "एवम् राम प्रयुक्ताः तु मार्गमाणाः ततः ततः |\nवैदेहीम् न अधिगच्छामो रात्रौ सूर्य प्रभाम् इव",
      "iast": "evam rāma prayuktāḥ tu mārgamāṇāḥ tataḥ tataḥ |\nvaidehīm na adhigacchāmo rātrau sūrya prabhām iva",
      "translation": "\"Though we are spearheaded by Rama and though we searched thereabouts for Vaidehi at the behest of Sugreeva, as with a nightly sunshine Vaidehi is unattainable for us...",
      "notes": [],
      "glosses": [
        {
          "itrans": "evam raama prayuktaaH tu",
          "iast": "evam rāma prayuktāḥ tu",
          "devanagari": "एवं राम प्रयुक्ताः तु",
          "meaning": "thus, by Rama, spearheaded, though",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "tataH tataH maargamaaNaaH",
          "iast": "tataḥ tataḥ mārgamāṇāḥ",
          "devanagari": "ततः ततः मार्गमाणाः",
          "meaning": "there, there, while searching",
          "anvayaIndex": 1,
          "verseIndex": 4
        },
        {
          "itrans": "raatrau suurya prabhaam iva",
          "iast": "rātrau sūrya prabhām iva",
          "devanagari": "रात्रौ सूर्य प्रभां इव",
          "meaning": "in night, sun, shine, as with",
          "anvayaIndex": 2,
          "verseIndex": 10
        },
        {
          "itrans": "vaidehiim na adhigacChaamaH",
          "iast": "vaidehīm na adhigacchāmaḥ",
          "devanagari": "वैदेहीं न अधिगच्छामः",
          "meaning": "at Vaidehi, not, we attained.",
          "anvayaIndex": 3,
          "verseIndex": 7
        }
      ]
    },
    {
      "id": "4.57.16",
      "label": "4.57.16",
      "numbers": [
        16
      ],
      "devanagari": "ते वयम् दण्दकारण्यम् विचित्य सुसमाहिताः |\nअज्ञानात् तु प्रविष्टाः स्म धरण्या विवृतम् बिलम्",
      "iast": "te vayam daṇdakāraṇyam vicitya susamāhitāḥ |\najñānāt tu praviṣṭāḥ sma dharaṇyā vivṛtam bilam",
      "translation": "\"Such as we were we searched Dandaka forest very meticulously, but we unwittingly entered into a wide-opened Black Hole of the earth...",
      "notes": [],
      "glosses": [
        {
          "itrans": "te vayam",
          "iast": "te vayam",
          "devanagari": "ते वयं",
          "meaning": "they, we were - such as we were",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "su samaahitaaH",
          "iast": "su samāhitāḥ",
          "devanagari": "सु समाहिताः",
          "meaning": "very, meticulously",
          "anvayaIndex": 1,
          "verseIndex": 4
        },
        {
          "itrans": "daNdaka araNyam",
          "iast": "daṇdaka araṇyam",
          "devanagari": "दण्दक अरण्यं",
          "meaning": "Dandaka forest",
          "anvayaIndex": 2,
          "verseIndex": 2
        },
        {
          "itrans": "vicitya",
          "iast": "vicitya",
          "devanagari": "विचित्य",
          "meaning": "having searched, a j~naanaat tu = without, knowledge [unwittingly,] but",
          "anvayaIndex": 3,
          "verseIndex": 3
        },
        {
          "itrans": "dharaNyaa vivR^itam bilam",
          "iast": "dharaṇyā vivṛtam bilam",
          "devanagari": "धरण्या विवृतं बिलं",
          "meaning": "earth's, wide-opened, hole [Black Hole]",
          "anvayaIndex": 4,
          "verseIndex": 9
        },
        {
          "itrans": "praviSTaaH sma",
          "iast": "praviṣṭāḥ sma",
          "devanagari": "प्रविष्टाः स्म",
          "meaning": "entered, we have.",
          "anvayaIndex": 5,
          "verseIndex": 7
        }
      ]
    },
    {
      "id": "4.57.17",
      "label": "4.57.17",
      "numbers": [
        17
      ],
      "devanagari": "मयस्य माया विहितम् तत् बिलम् च विचिन्वताम् |\nव्यतीतः तत्र नः मासः यः राज्ञा समयः कृतः",
      "iast": "mayasya māyā vihitam tat bilam ca vicinvatām |\nvyatītaḥ tatra naḥ māsaḥ yaḥ rājñā samayaḥ kṛtaḥ",
      "translation": "\"During our search in that Black Hole, which was crafted by the wizardry of demon Maya, the month fixed by our king for our return has been elapsed...",
      "notes": [],
      "glosses": [
        {
          "itrans": "mayasya maayaa vihitam",
          "iast": "mayasya māyā vihitam",
          "devanagari": "मयस्य माया विहितं",
          "meaning": "by demon Maya's, with wizardary, crafted",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "tat bilam vicinvataam",
          "iast": "tat bilam vicinvatām",
          "devanagari": "तत् बिलं विचिन्वतां",
          "meaning": "that, hole, while searching",
          "anvayaIndex": 1,
          "verseIndex": 3
        },
        {
          "itrans": "naH",
          "iast": "naḥ",
          "devanagari": "नः",
          "meaning": "for us",
          "anvayaIndex": 2,
          "verseIndex": 9
        },
        {
          "itrans": "yaH raaj~naa samayaH kR^itaH",
          "iast": "yaḥ rājñā samayaḥ kṛtaḥ",
          "devanagari": "यः राज्ञा समयः कृतः",
          "meaning": "which, by king, time, framed",
          "anvayaIndex": 3,
          "verseIndex": 11
        },
        {
          "itrans": "maasaH",
          "iast": "māsaḥ",
          "devanagari": "मासः",
          "meaning": "month",
          "anvayaIndex": 4,
          "verseIndex": 10
        },
        {
          "itrans": "tatra vyatiitaH",
          "iast": "tatra vyatītaḥ",
          "devanagari": "तत्र व्यतीतः",
          "meaning": "in there, elapsed.",
          "anvayaIndex": 5,
          "verseIndex": 7
        }
      ]
    },
    {
      "id": "4.57.18",
      "label": "4.57.18",
      "numbers": [
        18
      ],
      "devanagari": "ते वयम् कपि राजस्य सर्वे वचन कारिणः |\nकृताम् संस्थाम् अतिक्रान्ता भयात् प्रायम् उपासिताः",
      "iast": "te vayam kapi rājasya sarve vacana kāriṇaḥ |\nkṛtām saṃsthām atikrāntā bhayāt prāyam upāsitāḥ",
      "translation": "\"We who are all supposed to execute the order of our king, we have exceeded the established norm of timeframe, and for fear of fury from our king Sugreeva we sat down for fast-unto-death...",
      "notes": [],
      "glosses": [
        {
          "itrans": "kapi raajasya vacana kaariNaH",
          "iast": "kapi rājasya vacana kāriṇaḥ",
          "devanagari": "कपि राजस्य वचन कारिणः",
          "meaning": "monkey, king's, word [order,] executives [bound]",
          "anvayaIndex": 0,
          "verseIndex": 2
        },
        {
          "itrans": "sarve te vayam",
          "iast": "sarve te vayam",
          "devanagari": "सर्वे ते वयं",
          "meaning": "all, such as, we are",
          "anvayaIndex": 1,
          "verseIndex": 0
        },
        {
          "itrans": "kR^itaam samsthaam ati kraantaa",
          "iast": "kṛtām samsthām ati krāntā",
          "devanagari": "कृतां सम्स्थां अति क्रान्ता",
          "meaning": "made [established,] norm, over, stepped",
          "anvayaIndex": 2,
          "verseIndex": 7
        },
        {
          "itrans": "bhayaat praayam upaasitaaH",
          "iast": "bhayāt prāyam upāsitāḥ",
          "devanagari": "भयात् प्रायं उपासिताः",
          "meaning": "owing to fear [from Sugreeva,] fast-unto-death, we sat down.",
          "anvayaIndex": 3,
          "verseIndex": 10
        }
      ]
    },
    {
      "id": "4.57.19",
      "label": "4.57.19",
      "numbers": [
        19
      ],
      "devanagari": "क्रुद्धे तस्मिन् तु काकुत्स्थे सुग्रीवे च स लक्ष्मणे |\nगतानाम् अपि सर्वेषाम् तत्र नः न अस्ति जीवितम्",
      "iast": "kruddhe tasmin tu kākutsthe sugrīve ca sa lakṣmaṇe |\ngatānām api sarveṣām tatra naḥ na asti jīvitam",
      "translation": "\"When Rama along with Lakshmana, and even Sugreeva will be infuriated by our infringement of time, and even on our going to Kishkindha, as infringers there will be no survival for all of us...\" Thus Angada narrated their plight to Sampaati.",
      "notes": [],
      "glosses": [
        {
          "itrans": "tasmin kaakutsthe",
          "iast": "tasmin kākutsthe",
          "devanagari": "तस्मिन् काकुत्स्थे",
          "meaning": "that, Kakutstha Rama",
          "anvayaIndex": 0,
          "verseIndex": 1
        },
        {
          "itrans": "sa lakSmaNe",
          "iast": "sa lakṣmaṇe",
          "devanagari": "स लक्ष्मणे",
          "meaning": "with, Lakshmana",
          "anvayaIndex": 1,
          "verseIndex": 6
        },
        {
          "itrans": "sugriive ca",
          "iast": "sugrīve ca",
          "devanagari": "सुग्रीवे च",
          "meaning": "with Sugreeva, also",
          "anvayaIndex": 2,
          "verseIndex": 4
        },
        {
          "itrans": "kruddhe",
