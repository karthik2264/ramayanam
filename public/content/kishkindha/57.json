          "devanagari": "ह्रियमाणां वैदेहीं सीतां",
          "meaning": "being abducted, princess from Videha kingdom",
          "anvayaIndex": 6,
          "verseIndex": 15
        },
        {
          "itrans": "dadarsha",
          "iast": "dadarśa",
          "devanagari": "ददर्श",
          "meaning": "saw.",
          "anvayaIndex": 7,
