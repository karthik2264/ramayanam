          "iast": "suraiḥ api su pūjitam",
          "devanagari": "सुरैः अपि सु पूजितं",
          "meaning": "by gods, even, well, reverenced",
          "anvayaIndex": 1,
          "verseIndex": 5
        },
        {
          "itrans": "puNyam aashramam aasiit",
          "iast": "puṇyam āśramam āsīt",
          "devanagari": "पुण्यं आश्रमं आसीत्",
          "meaning": "a sacred, hermitage, is there",
          "anvayaIndex": 2,
          "verseIndex": 0
        },
        {
          "itrans": "yasmin",
          "iast": "yasmin",
          "devanagari": "यस्मिन्",
          "meaning": "wherein",
          "anvayaIndex": 3,
          "verseIndex": 11
        },
        {
          "itrans": "nishaakaraH naama",
          "iast": "niśākaraḥ nāma",
          "devanagari": "निशाकरः नाम",
          "meaning": "sage Nishaakara, known as",
          "anvayaIndex": 4,
          "verseIndex": 9
        },
        {
          "itrans": "ugra tapaaH",
          "iast": "ugra tapāḥ",
          "devanagari": "उग्र तपाः",
          "meaning": "of intense, ascesis",
          "anvayaIndex": 5,
          "verseIndex": 12
        },
        {
          "itrans": "R^iSiH abhavat",
          "iast": "ṛṣiḥ abhavat",
          "devanagari": "ऋषिः अभवत्",
          "meaning": "a sage, was there.",
          "anvayaIndex": 6,
          "verseIndex": null
        }
      ]
    },
    {
      "id": "4.60.9",
      "label": "4.60.9",
      "numbers": [
        9
      ],
      "devanagari": "अष्टौ वर्ष सहस्राणि तेन अस्मिन् ऋषिणा गिरौ |\nवसतो मम धर्मज्ञो स्वर् गते तु निशाकरे",
      "iast": "aṣṭau varṣa sahasrāṇi tena asmin ṛṣiṇā girau |\nvasato mama dharmajño svar gate tu niśākare",
      "translation": "\"Eight thousand years have lapsed while I was living here on this mountain after the departure of that probity knowing sage Nishakara to heaven.",
      "notes": [],
      "glosses": [
        {
          "itrans": "dharma j~naH",
          "iast": "dharma jñaḥ",
          "devanagari": "धर्म ज्ञः",
          "meaning": "probity, knower of",
          "anvayaIndex": 0,
          "verseIndex": 9
        },
        {
          "itrans": "nishaakare",
          "iast": "niśākare",
          "devanagari": "निशाकरे",
          "meaning": "of Nishaakara's",
          "anvayaIndex": 1,
          "verseIndex": 13
        },
        {
          "itrans": "svar gate tu",
          "iast": "svar gate tu",
          "devanagari": "स्वर् गते तु",
          "meaning": "to heaven, after going, on his part",
          "anvayaIndex": 2,
          "verseIndex": 10
