          "anvayaIndex": 0,
          "verseIndex": 5
        },
        {
          "itrans": "tam R^iSim draSTu kaamaH asmi",
          "iast": "tam ṛṣim draṣṭu kāmaḥ asmi",
          "devanagari": "तं ऋषिं द्रष्टु कामः अस्मि",
          "meaning": "him, sage, to see, desiring, I have become",
          "anvayaIndex": 1,
          "verseIndex": 0
        },
        {
          "itrans": "saH",
          "iast": "saḥ",
          "devanagari": "सः",
          "meaning": "he - that sage",
          "anvayaIndex": 2,
          "verseIndex": 14
        },
        {
