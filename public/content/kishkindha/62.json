    {
      "id": "4.62.9",
      "label": "4.62.9",
      "numbers": [
        9
      ],
      "devanagari": "तत् अन्नम् मैथिली प्राप्य विज्ञाय इन्द्रात् इदम् तु इति |\nअग्रम् उद्धृत्य रामाय भू तले निर्वपिष्यति",
      "iast": "tat annam maithilī prāpya vijñāya indrāt idam tu iti |\nagram uddhṛtya rāmāya bhū tale nir.hvapiṣyati",
      "translation": "\" 'But on getting that food, and on knowing that it is from Indra, Maithili takes up the first morsel and dispenses it on the surface of earth for Rama, saying...",
      "notes": [],
      "glosses": [
        {
          "itrans": "maithilii tat annam praapya",
          "iast": "maithilī tat annam prāpya",
          "devanagari": "मैथिली तत् अन्नं प्राप्य",
          "meaning": "Maithili, that, food, on getting",
          "anvayaIndex": 0,
          "verseIndex": 0
        },
        {
          "itrans": "idam indraat iti",
          "iast": "idam indrāt iti",
          "devanagari": "इदं इन्द्रात् इति",
          "meaning": "this [food is,] from Indra, thus",
          "anvayaIndex": 1,
          "verseIndex": 5
        },
        {
          "itrans": "vij~naaya",
          "iast": "vijñāya",
          "devanagari": "विज्ञाय",
          "meaning": "on knowing",
          "anvayaIndex": 2,
          "verseIndex": 4
