          "anvayaIndex": 7,
          "verseIndex": 8
        }
      ]
    },
    {
      "id": "4.62.8",
      "label": "4.62.8",
      "numbers": [
        8
      ],
      "devanagari": "परमान्नम् च वैदेह्या ज्ञात्वा दास्यति वासवः |\nयत् अन्नम् अमृत प्रख्यम् सुराणाम् अपि दुर्लभम्",
      "iast": "paramānnam ca vaidehyā jñātvā dāsyati vāsavaḥ |\nyat annam amṛta prakhyam surāṇām api dur.hlabham",
      "translation": "\" 'On knowing Seetha's plight Indra gives a nectarean food for Vaidehi, which food is renowned to be Nectarous and unattainable even by gods...",
      "notes": [],
      "glosses": [
        {
          "itrans": "vaasavaH j~naatvaa",
          "iast": "vāsavaḥ jñātvā",
          "devanagari": "वासवः ज्ञात्वा",
          "meaning": "Indra, on knowing [Seetha's plight]",
          "anvayaIndex": 0,
          "verseIndex": 3
        },
        {
          "itrans": "suraaNaam api dur labham",
          "iast": "surāṇām api dur labham",
          "devanagari": "सुराणां अपि दुर् लभं",
          "meaning": "for gods, even, un, attainable - food",
          "anvayaIndex": 1,
          "verseIndex": 10
        },
        {
          "itrans": "amR^ita prakhyam",
          "iast": "amṛta prakhyam",
          "devanagari": "अमृत प्रख्यं",
          "meaning": "nectarous, renowned as",
          "anvayaIndex": 2,
          "verseIndex": 8
        },
        {
          "itrans": "yat annam",
          "iast": "yat annam",
          "devanagari": "यत् अन्नं",
          "meaning": "which food - is there in all three worlds, that",
          "anvayaIndex": 3,
          "verseIndex": 6
        },
        {
          "itrans": "parama annam",
          "iast": "parama annam",
          "devanagari": "परम अन्नं",
          "meaning": "nectarean, food",
          "anvayaIndex": 4,
          "verseIndex": 0
        },
        {
          "itrans": "vaidehyaa daasyati",
          "iast": "vaidehyā dāsyati",
          "devanagari": "वैदेह्या दास्यति",
          "meaning": "for Vaidehi, he gives.",
          "anvayaIndex": 5,
          "verseIndex": 2
        }
      ]
