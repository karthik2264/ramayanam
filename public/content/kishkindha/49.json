          "verseIndex": 14
        },
        {
          "itrans": "vaH hita artham",
          "iast": "vaḥ hita artham",
          "devanagari": "वः हित अर्थं",
          "meaning": "for your, well-being, for the purpose of",
          "anvayaIndex": 1,
          "verseIndex": null
        },
        {
          "itrans": "etat uktam",
          "iast": "etat uktam",
          "devanagari": "एतत् उक्तं",
          "meaning": "all this, is said [by me]",
          "anvayaIndex": 2,
          "verseIndex": 1
        },
        {
          "itrans": "rocate yadi",
          "iast": "rocate yadi",
          "devanagari": "रोचते यदि",
          "meaning": "you like it, if",
          "anvayaIndex": 3,
          "verseIndex": 5
        },
        {
          "itrans": "kriyataam",
          "iast": "kriyatām",
          "devanagari": "क्रियतां",
          "meaning": "it may be done - further searching for Seetha",
          "anvayaIndex": 4,
          "verseIndex": 4
        },
        {
          "itrans": "yat sarveSaam eva kSamam",
          "iast": "yat sarveṣām eva kṣamam",
          "devanagari": "यत् सर्वेषां एव क्षमं",
          "meaning": "which, for all of us, befitting",
          "anvayaIndex": 5,
          "verseIndex": 9
        },
        {
          "itrans": "tat ucyataam hi",
          "iast": "tat ucyatām hi",
          "devanagari": "तत् उच्यतां हि",
          "meaning": "that, may be said, indeed.",
          "anvayaIndex": 6,
          "verseIndex": 7
        }
      ]
    },
    {
      "id": "4.49.11",
      "label": "4.49.11",
      "numbers": [
        11
      ],
      "devanagari": "अंगदस्य वचः श्रुत्वा वचनम् गंधमादनः |\nउवाच व्यक्तया वाचा पिपासा श्रम खिन्नया",
      "iast": "aṃgadasya vacaḥ śrutvā vacanam gaṃdhamādanaḥ |\nuvāca vyaktayā vācā pipāsā śrama khinnayā",
      "translation": "On hearing Angada's words, Gandhamaadana who is enervated with thirst and fatigue spoke this sentence with inexplicit words.",
