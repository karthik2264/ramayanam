          "meaning": "great [deal of,] time, lapsed also - from the day of starting",
          "anvayaIndex": 1,
          "verseIndex": 0
        },
        {
          "itrans": "sugriivaH ca ugra shaasanaH",
          "iast": "sugrīvaḥ ca ugra śāsanaḥ",
          "devanagari": "सुग्रीवः च उग्र शासनः",
