{
  "kanda": "ayodhya",
  "sarga": 80,
  "title": "Construction of a high-way from Ayodhya to River Ganga",
  "sourceUrl": "https://www.valmikiramayan.net/utf8/ayodhya/sarga80/ayodhyasans80.htm",
  "romanUrl": "https://www.valmikiramayan.net/utf8/ayodhya/sarga80/ayodhyaitrans80.htm",
  "translator": "K. M. K. Murthy",
  "introduction": [
    "The engineers construct a comfortably high-way from Ayodhya to the River Ganga, by clearing off shrubs and stones on the way and excellent wells were dug. Beautiful tents were also built on the path."
  ],
  "closing": [
    "इत्यार्षे श्रीमद्रामायणे आदिकाव्ये अयोध्याकाण्डे अशीतितमह् सर्गः",
    "Thus completes 80th Chapter of Ayodhya Kanda of the glorious Ramayana of Valmiki, the work of a sage and the oldest epic."
  ],
